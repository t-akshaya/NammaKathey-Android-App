<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardRoot"
    android:layout_width="200dp"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="6dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/ivHeroImage"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_gravity="center_horizontal"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvHeroEmoji"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:text="⚔️"
                android:textSize="48sp"
                android:gravity="center"
                android:layout_gravity="center_horizontal" />
            <TextView android:id="@+id/tvCompletedBadge"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="✅" android:textSize="20sp"
                android:layout_gravity="top|end" android:visibility="gone" />
            <TextView android:id="@+id/btnFavorite"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="🤍" android:textSize="20sp"
                android:layout_gravity="top|start" android:padding="4dp" />
        </FrameLayout>

        <TextView android:id="@+id/tvHeroName"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Hero Name" android:textColor="@color/primary"
            android:textSize="16sp" android:textStyle="bold"
            android:gravity="center" android:layout_marginTop="10dp"
            android:maxLines="2" android:ellipsize="end" />

        <TextView android:id="@+id/tvHeroTitle"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Title" android:textColor="@color/text_secondary"
            android:textSize="12sp" android:gravity="center"
            android:layout_marginTop="4dp" android:maxLines="2" android:ellipsize="end" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="10dp">
            <TextView android:id="@+id/tvCategoryTag"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="Fighter"
                android:textSize="10sp" android:textColor="@color/white"
                android:background="@drawable/bg_tag_primary"
                android:gravity="center" android:padding="4dp" />
        </LinearLayout>

        <TextView android:id="@+id/tvDistrictTag"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="📍 District" android:textColor="@color/saffron"
            android:textSize="11sp" android:layout_marginTop="6dp"
            android:gravity="center" />

        <TextView android:id="@+id/tvHeroEra"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Era" android:textColor="@color/text_hint"
            android:textSize="10sp" android:gravity="center"
            android:layout_marginTop="2dp" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
