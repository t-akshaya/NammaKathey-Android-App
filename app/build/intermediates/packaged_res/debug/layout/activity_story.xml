<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main">

    <!-- Top Bar -->
    <LinearLayout android:id="@+id/topBar"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@drawable/bg_story_header"
        android:orientation="vertical" android:paddingTop="40dp" android:paddingBottom="12dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <Button android:id="@+id/btnBack"
                android:layout_width="40dp" android:layout_height="40dp"
                android:text="←" android:backgroundTint="#33FFFFFF"
                android:textColor="#FFFFFF" android:textSize="18sp" android:padding="0dp" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:layout_marginHorizontal="12dp">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:id="@+id/tvHeroEmoji"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="⚔️" android:textSize="28sp" android:layout_marginEnd="8dp" />
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <TextView android:id="@+id/tvHeroName"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Hero Name" android:textColor="#FFFFFF"
                            android:textSize="18sp" android:textStyle="bold" />
                        <TextView android:id="@+id/tvHeroTitle"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Title" android:textColor="#FFECB3" android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal">
                <Button android:id="@+id/btnFavorite"
                    android:layout_width="40dp" android:layout_height="40dp"
                    android:text="🤍" android:backgroundTint="#33FFFFFF"
                    android:padding="0dp" android:layout_marginEnd="8dp" />
                <Button android:id="@+id/btnToggleLang"
                    android:layout_width="wrap_content" android:layout_height="40dp"
                    android:text="ಕನ್ನಡ" android:backgroundTint="#FFCA28"
                    android:textColor="#212121" android:textSize="12sp" android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Category + Progress row -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="8dp">
            <TextView android:id="@+id/tvCategoryChip"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Freedom Fighter" android:textColor="#FFFFFF"
                android:textSize="11sp" android:background="@drawable/bg_chip_white"
                android:paddingHorizontal="10dp" android:paddingVertical="4dp" />
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
            <TextView android:id="@+id/tvPageCounter"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="1 / 3" android:textColor="#FFFFFF" android:textSize="13sp" />
        </LinearLayout>

        <ProgressBar android:id="@+id/progressStory"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent" android:layout_height="6dp"
            android:progressTint="#FFCA28" android:progressBackgroundTint="#33FFFFFF"
            android:max="100" android:layout_marginTop="8dp" />
    </LinearLayout>

    <!-- Dots Indicator -->
    <com.tbuonomo.viewpagerdotsindicator.DotsIndicator
        android:id="@+id/dotsIndicator"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:dotsColor="@color/primary" app:selectedDotColor="@color/saffron"
        app:dotsSize="8dp" app:dotsSpacing="4dp"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ViewPager -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/storyViewPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/dotsIndicator"
        app:layout_constraintBottom_toTopOf="@id/bottomControls"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Bottom Controls -->
    <LinearLayout android:id="@+id/bottomControls"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:background="@color/white"
        android:padding="12dp" android:elevation="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="8dp">
            <Button android:id="@+id/btnPrevPage"
                android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
                android:text="◀ Prev" android:textColor="@color/primary"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_marginEnd="6dp" />
            <Button android:id="@+id/btnListen"
                android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
                android:text="🔊 Listen" android:backgroundTint="@color/india_green"
                android:layout_marginHorizontal="3dp" />
            <Button android:id="@+id/btnNextPage"
                android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
                android:text="Next ▶" android:backgroundTint="@color/primary"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/fabQuiz"
            android:layout_width="match_parent" android:layout_height="52dp"
            android:text="🎯 Take the Hero Quiz!"
            android:textSize="16sp" android:textStyle="bold"
            app:backgroundTint="@color/saffron" android:textColor="#FFFFFF" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
