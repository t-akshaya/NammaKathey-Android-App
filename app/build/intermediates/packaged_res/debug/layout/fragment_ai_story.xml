<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_ai_header_gradient"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="24dp">

                <TextView
                    android:id="@+id/tvAiHeroEmoji"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✨"
                    android:textSize="64sp"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🤖 AI Story Mode"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/tvAiHeroName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hero Name"
                    android:textColor="#FFECB3"
                    android:textSize="16sp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Age Group Selection -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvAiPromptLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Choose your age group — AI generates the story!"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginBottom="20dp" />

                <Button
                    android:id="@+id/btnAge58"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="🧒 Age 5–8 (Little Explorer)"
                    android:textSize="15sp"
                    android:backgroundTint="#FF6B35"
                    android:layout_marginBottom="10dp" />

                <Button
                    android:id="@+id/btnAge912"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="👦 Age 9–12 (Young Learner)"
                    android:textSize="15sp"
                    android:backgroundTint="#2D6A4F"
                    android:layout_marginBottom="10dp" />

                <Button
                    android:id="@+id/btnAge1316"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="🧑 Age 13–16 (Heritage Scholar)"
                    android:textSize="15sp"
                    android:backgroundTint="#4A148C" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Loading -->
        <ProgressBar
            android:id="@+id/progressAi"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_gravity="center"
            android:layout_marginVertical="16dp"
            android:visibility="gone"
            android:layout_marginHorizontal="16dp" />

        <!-- AI Output Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardAiOutput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:cardCornerRadius="20dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✨"
                        android:textSize="24sp"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AI Generated Story"
                        android:textColor="@color/primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:background="@color/divider"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:id="@+id/tvAiStoryOutput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/text_primary"
                    android:textSize="17sp"
                    android:lineSpacingMultiplier="1.8" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="⚠️ AI-generated content. Core facts are based on historical records."
                    android:textColor="@color/text_hint"
                    android:textSize="11sp"
                    android:layout_marginTop="16dp"
                    android:gravity="center" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
