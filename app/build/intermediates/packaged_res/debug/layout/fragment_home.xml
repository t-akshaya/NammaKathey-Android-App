<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header Banner -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/bg_header_gradient"
            android:padding="20dp" android:paddingTop="48dp" android:orientation="vertical">

            <TextView android:id="@+id/tvWelcome" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="Hello, Explorer! 👋"
                android:textColor="#FFFFFF" android:textSize="26sp" android:textStyle="bold"
                android:fontFamily="sans-serif-medium" />
            <TextView android:id="@+id/tvSubtitle" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="Whose story shall we read today?"
                android:textColor="#FFECB3" android:textSize="15sp" android:layout_marginTop="4dp" />

            <!-- Stats Row -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginTop="20dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:gravity="center"
                    android:background="@drawable/bg_stat_card" android:padding="12dp" android:layout_marginEnd="8dp">
                    <TextView android:id="@+id/tvStoriesCount" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="0"
                        android:textColor="#FFFFFF" android:textSize="28sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Stories Read" android:textColor="#FFECB3" android:textSize="12sp" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:gravity="center"
                    android:background="@drawable/bg_stat_card" android:padding="12dp" android:layout_marginStart="8dp">
                    <TextView android:id="@+id/tvBadgesCount" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="0"
                        android:textColor="#FFCA28" android:textSize="28sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Badges Earned" android:textColor="#FFECB3" android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Search -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:padding="16dp" android:gravity="center_vertical">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etSearch" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:hint="🔍 Search heroes..."
                android:background="@drawable/bg_search_field" android:padding="14dp"
                android:imeOptions="actionSearch" android:inputType="text" android:singleLine="true" />
            <Button android:id="@+id/btnClearSearch" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="✕"
                android:backgroundTint="#EEEEEE" android:textColor="#757575"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- Daily Hero Card -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="🌟 Hero of the Day" android:textSize="18sp" android:textStyle="bold"
            android:textColor="@color/text_primary" android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="8dp" />

        <androidx.cardview.widget.CardView android:id="@+id/cardDailyHero"
            android:layout_width="match_parent" android:layout_height="140dp"
            android:layout_marginHorizontal="16dp" android:layout_marginBottom="20dp"
            app:cardCornerRadius="20dp" app:cardElevation="8dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                android:background="@drawable/bg_daily_hero_gradient"
                android:orientation="horizontal" android:padding="20dp" android:gravity="center_vertical">
                <TextView android:id="@+id/tvDailyHeroEmoji" android:layout_width="80dp"
                    android:layout_height="80dp" android:text="⚔️" android:textSize="56sp"
                    android:gravity="center" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="12dp">
                    <TextView android:id="@+id/tvDailyHeroName" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textColor="#FFFFFF"
                        android:textSize="20sp" android:textStyle="bold" />
                    <TextView android:id="@+id/tvDailyHeroTitle" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textColor="#FFECB3"
                        android:textSize="13sp" android:layout_marginTop="2dp" />
                    <TextView android:id="@+id/tvDailyHeroDistrict" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textColor="#FFFFFF"
                        android:textSize="12sp" android:layout_marginTop="8dp" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="▶" android:textColor="#FFFFFF" android:textSize="24sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- All Heroes Section -->
        <TextView android:id="@+id/tvSectionHeroes" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="All Heroes"
            android:textSize="18sp" android:textStyle="bold" android:textColor="@color/text_primary"
            android:layout_marginHorizontal="16dp" android:layout_marginBottom="8dp" />

        <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvHeroes"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingHorizontal="8dp" android:clipToPadding="false"
            android:paddingBottom="24dp" />

    </LinearLayout>
</ScrollView>
