<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main">

    <!-- Header -->
    <LinearLayout android:id="@+id/quizHeader"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@drawable/bg_quiz_header"
        android:orientation="vertical" android:paddingTop="40dp" android:paddingBottom="16dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <Button android:id="@+id/btnBack"
                android:layout_width="40dp" android:layout_height="40dp"
                android:text="←" android:backgroundTint="#33FFFFFF"
                android:textColor="#FFFFFF" android:textSize="18sp" android:padding="0dp" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="horizontal"
                android:gravity="center_vertical" android:layout_marginHorizontal="12dp">
                <TextView android:id="@+id/tvHeroEmoji"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="⚔️" android:textSize="28sp" android:layout_marginEnd="8dp" />
                <TextView android:id="@+id/tvHeroName"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="Hero Quiz"
                    android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold" />
            </LinearLayout>
            <TextView android:id="@+id/tvScore"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="⭐ 0" android:textColor="#FFCA28"
                android:textSize="18sp" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="12dp">
            <TextView android:id="@+id/tvProgress"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Question 1 of 3" android:textColor="#FFFFFF" android:textSize="13sp"
                android:layout_marginEnd="12dp" />
            <ProgressBar android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp" android:layout_height="8dp" android:layout_weight="1"
                android:progressTint="#FFCA28" android:progressBackgroundTint="#33FFFFFF"
                android:max="100" />
        </LinearLayout>
    </LinearLayout>

    <!-- Timer -->
    <LinearLayout android:id="@+id/timerRow"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingHorizontal="16dp" android:paddingVertical="8dp"
        app:layout_constraintTop_toBottomOf="@id/quizHeader">
        <ProgressBar android:id="@+id/timerProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp" android:layout_height="10dp" android:layout_weight="1"
            android:progressTint="@color/india_green" android:progressBackgroundTint="#E0E0E0"
            android:max="100" android:progress="100" android:layout_marginEnd="12dp" />
        <TextView android:id="@+id/tvTimer"
            android:layout_width="48dp" android:layout_height="wrap_content"
            android:text="20s" android:textColor="@color/india_green"
            android:textSize="16sp" android:textStyle="bold" android:gravity="center" />
    </LinearLayout>

    <!-- Scrollable quiz content -->
    <ScrollView
        android:layout_width="match_parent" android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/timerRow"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp">

            <!-- Question Card -->
            <androidx.cardview.widget.CardView android:id="@+id/cardQuestion"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="20dp" app:cardElevation="8dp" app:cardBackgroundColor="#FFFFFF">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="24dp" android:gravity="center">
                    <TextView android:id="@+id/tvQuestion"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Question goes here?" android:textColor="@color/text_primary"
                        android:textSize="20sp" android:textStyle="bold"
                        android:gravity="center" android:lineSpacingMultiplier="1.4" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Options -->
            <Button android:id="@+id/btnOpt1" android:layout_width="match_parent"
                android:layout_height="56dp" android:text="Option 1"
                android:backgroundTint="#FFFFFF" android:textColor="@color/text_primary"
                android:textSize="15sp" android:layout_marginBottom="10dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:strokeColor="@color/divider" app:cornerRadius="14dp" />
            <Button android:id="@+id/btnOpt2" android:layout_width="match_parent"
                android:layout_height="56dp" android:text="Option 2"
                android:backgroundTint="#FFFFFF" android:textColor="@color/text_primary"
                android:textSize="15sp" android:layout_marginBottom="10dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:strokeColor="@color/divider" app:cornerRadius="14dp" />
            <Button android:id="@+id/btnOpt3" android:layout_width="match_parent"
                android:layout_height="56dp" android:text="Option 3"
                android:backgroundTint="#FFFFFF" android:textColor="@color/text_primary"
                android:textSize="15sp" android:layout_marginBottom="10dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:strokeColor="@color/divider" app:cornerRadius="14dp" />
            <Button android:id="@+id/btnOpt4" android:layout_width="match_parent"
                android:layout_height="56dp" android:text="Option 4"
                android:backgroundTint="#FFFFFF" android:textColor="@color/text_primary"
                android:textSize="15sp" android:layout_marginBottom="16dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:strokeColor="@color/divider" app:cornerRadius="14dp" />

            <!-- Explanation -->
            <TextView android:id="@+id/tvExplanation"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Explanation here" android:textColor="@color/india_green"
                android:textSize="14sp" android:lineSpacingMultiplier="1.4"
                android:background="@drawable/bg_explanation"
                android:padding="16dp" android:visibility="gone" android:layout_marginBottom="16dp" />

            <!-- Lottie overlays -->
            <FrameLayout android:layout_width="match_parent" android:layout_height="120dp">
                <com.airbnb.lottie.LottieAnimationView android:id="@+id/lottieCorrect"
                    android:layout_width="120dp" android:layout_height="120dp"
                    android:layout_gravity="center"
                    app:lottie_rawRes="@raw/correct_animation"
                    app:lottie_autoPlay="false" app:lottie_loop="false"
                    android:visibility="gone" />
                <com.airbnb.lottie.LottieAnimationView android:id="@+id/lottieWrong"
                    android:layout_width="120dp" android:layout_height="120dp"
                    android:layout_gravity="center"
                    app:lottie_rawRes="@raw/wrong_animation"
                    app:lottie_autoPlay="false" app:lottie_loop="false"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
